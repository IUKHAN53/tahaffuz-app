{
  "expo": {
    "name": "Tahaffuz",
    "slug": "tahaffuz",
    "version": "0.2.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07203F"
    },
    "android": {
      "package": "com.tahaffuz.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07203F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "apiBase": "https://tahaffuz.tpfm.tameerekhalaq.org",
      "eas": {
        "projectId": "707a21b8-e883-4114-9ee4-a383de2e745e"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Tahaffuz uses your microphone for voice questions."
        }
      ],
      "expo-asset"
    ],
    "owner": "iukhan"
  }
}
