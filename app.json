{
  "expo": {
    "name": "Tahaffuz",
    "slug": "tahaffuz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07203F"
    },
    "android": {
      "package": "com.tahaffuz.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07203F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "extra": {
      "apiBase": "https://tahaffuz.tpfm.tameerekhalaq.org"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Tahaffuz uses your microphone for voice questions."
        }
      ]
    ]
  }
}
